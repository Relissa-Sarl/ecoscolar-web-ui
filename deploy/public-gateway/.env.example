# Public gateway port consumed by Tailscale Serve/Funnel.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=3100

# Image tags published by the CI/CD pipelines.
FRONTEND_IMAGE_TAG=latest
BACKEND_IMAGE_TAG=latest

# Backend runtime configuration.
APPLY_DATABASE_MIGRATIONS=true
ECOSCOLAR_SQL_CONNECTION_STRING=Server=<TAILSCALE_SQL_HOST>,1433;Initial Catalog=ecoscolar_pi;User ID=sa;Password=<PASSWORD>;TrustServerCertificate=True;Encrypt=True
STRIPE_SECRET_KEY=sk_test_dummy
